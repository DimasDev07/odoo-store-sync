# Copy to .env and fill in. Real environment variables win over this file.

# memory = in-memory demo with 3 seeded SKUs, touches nothing external (default)
# live   = Odoo -> PrestaShop for real; requires every variable below
SYNC_MODE=memory

# --- Odoo (external JSON-RPC API, Odoo 17/18) -------------------------------
# Base URL of the instance, e.g. https://mycompany.odoo.com
ODOO_URL=http://localhost:8069
# Database name. On Odoo Online it is the subdomain, e.g. "mycompany".
ODOO_DB=odoo
# Login of the integration user (an email address on most instances).
ODOO_USERNAME=admin
# API key for that user, sent in place of the password.
# Create it in Odoo: avatar menu > Preferences > Account Security > New API Key.
# (Turn on developer mode if you do not see the button.) The key is shown once.
# Plan note: the external API needs the Custom plan on Odoo Online.
ODOO_API_KEY=
# Optional. Comma-separated stock.warehouse ids, e.g. 1,2. When set, stock is
# read from stock.quant (internal locations of those warehouses) and summed;
# when empty, product.product.qty_available (all warehouses) is used.
ODOO_WAREHOUSE_IDS=

# --- PrestaShop (webservice, 1.7 / 8) ---------------------------------------
# Base URL of the shop, without /api.
PRESTASHOP_URL=http://localhost:8080
# Webservice key. Create it in the back office:
#   Advanced Parameters > Webservice > Enable PrestaShop's webservice = Yes,
#   then "Add new webservice key" > Generate, status Enabled, and grant:
#     products          GET
#     stock_availables  GET, PUT
PRESTASHOP_WS_KEY=

# --- Retry tuning (optional) ------------------------------------------------
# Total attempts per job, including the first one (1-10).
SYNC_MAX_ATTEMPTS=4
# Exponential backoff with full jitter: wait is random in [0, min(max, base * 2^(n-1))].
SYNC_BASE_DELAY_MS=500
SYNC_MAX_DELAY_MS=30000
