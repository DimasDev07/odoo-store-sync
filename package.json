{
  "name": "odoo-store-sync",
  "version": "0.1.0",
  "description": "Hosted synchronization service between Odoo (ERP) and ecommerce stores, starting with PrestaShop.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Dimas Bueno",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "sync:stock": "tsx --env-file-if-exists=.env src/main.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
